# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"

if [ -f "$HOME/.config/makaron/makaron.conf" ]; then
  # shellcheck disable=SC1090
  source "$HOME/.config/makaron/makaron.conf"
fi
SKETCHYBAR_COMPACT_MODE="${SKETCHYBAR_COMPACT_MODE:-false}"

source "$CONFIG_DIR/colors.sh"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

# Floating liquid-glass bar. y_offset=4 must match MAKARON_BAR_Y_OFFSET in
# bin/makaron-ui-helpers (it is part of the window outer.top math).
sketchybar --bar position=top height=${SKETCHYBAR_HEIGHT:-40} margin=12 y_offset=4 \
           corner_radius=16 border_width=1 border_color=${BAR_BORDER_COLOR:-0x40ffffff} \
           color=$BAR_COLOR background.color=$BAR_BACKGROUND_COLOR background.blur=${BAR_BLUR:-0}

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=3
  padding_right=3
  icon.font="Hack Nerd Font:Bold:14.0"
  label.font="SF Pro:Medium:13.0"
  icon.color=$ICON_COLOR
  label.color=$LABEL_COLOR
  icon.padding_left=3
  icon.padding_right=3
  label.padding_left=3
  label.padding_right=3
)
sketchybar --default "${default[@]}"

##### Makaron Menu (the "Apple menu" of the bar) #####
# A small M mark; click opens a popup with Makaron actions.
SKETCHYBAR_LOGO="${SKETCHYBAR_LOGO:-true}"
if [ "$SKETCHYBAR_LOGO" = "true" ]; then
  sketchybar --add item makaron_logo left \
             --set makaron_logo icon.drawing=off label.drawing=off \
                   padding_left=6 padding_right=14 width=40 \
                   background.drawing=on \
                   background.color=0x00000000 \
                   background.image="$CONFIG_DIR/assets/${MAKARON_LOGO_IMAGE:-makaron-m@2x.png}" \
                   background.image.scale=0.5 \
                   click_script="$PLUGIN_DIR/makaron_logo_click.sh" \
                   popup.background.color=$BAR_COLOR \
                   popup.background.corner_radius=12 \
                   popup.background.blur_radius=${BAR_BLUR:-0} \
                   popup.background.border_width=1 \
                   popup.background.border_color=${BAR_BORDER_COLOR:-0x40ffffff} \
             --add item makaron.version popup.makaron_logo \
             --set makaron.version label="Makaron" update_freq=3600 \
                   label.padding_left=10 label.padding_right=10 \
                   script="$PLUGIN_DIR/makaron_menu.sh" \
             --add item makaron.shortcuts popup.makaron_logo \
             --set makaron.shortcuts label="Shortcuts" \
                   click_script="sketchybar --set makaron_logo popup.drawing=off; $HOME/.local/share/makaron/bin/makaron-help" \
             --add item makaron.update popup.makaron_logo \
             --set makaron.update label="Update" \
                   click_script="sketchybar --set makaron_logo popup.drawing=off; open -na Ghostty --args -e $HOME/.local/share/makaron/bin/makaron-update" \
             --add item makaron.doctor popup.makaron_logo \
             --set makaron.doctor label="Doctor" \
                   click_script="sketchybar --set makaron_logo popup.drawing=off; open -na Ghostty --args -e /bin/bash -c '$HOME/.local/share/makaron/bin/makaron-doctor; echo; read -n 1 -s -p \"Press any key to close\"'" \
             --add item makaron.reload popup.makaron_logo \
             --set makaron.reload label="Reload bar" \
                   click_script="sketchybar --set makaron_logo popup.drawing=off; $HOME/.local/share/makaron/bin/makaron-reload-aerospace-sketchybar"
fi

##### Update Indicator #####
# Amber pill next to the M mark; hidden unless a newer release (or main on
# edge) is available. Click runs makaron-update in a new Ghostty window.
sketchybar --add item makaron_update left \
           --set makaron_update update_freq=14400 drawing=off \
                       padding_right=15 \
                       icon="󰚰" icon.color=$UPDATE_COLOR \
                       icon.padding_left=8 icon.padding_right=2 \
                       label="Update" label.color=$UPDATE_COLOR \
                       label.padding_left=2 label.padding_right=8 \
                       background.drawing=on background.corner_radius=12 background.height=24 \
                       background.color=$UPDATE_BACKGROUND_COLOR \
                       script="$PLUGIN_DIR/update_check.sh" \
                       click_script="open -na Ghostty --args -e $HOME/.local/share/makaron/bin/makaron-update" \
           --subscribe makaron_update system_woke

##### Adding AeroSpace Workspace Indicators #####
# Integration with AeroSpace window manager
# https://nikitabobko.github.io/AeroSpace/goodness#show-aerospace-workspaces-in-sketchybar

sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_focus_change

# Detect number of monitors
MONITOR_COUNT=$(aerospace list-monitors | wc -l | tr -d ' ')

if [ "$MONITOR_COUNT" -eq 1 ]; then
  # Single monitor: Show all workspaces without display assignment
  for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space.$sid left \
      --subscribe space.$sid aerospace_workspace_change aerospace_focus_change front_app_switched \
      --set space.$sid \
      padding_left=2 \
      padding_right=2 \
      icon="$sid" \
      icon.padding_left=6 \
      icon.padding_right=4 \
      icon.color=$SPACE_ICON_COLOR \
      label.padding_left=2 \
      label.padding_right=6 \
      label.font="Hack Nerd Font:Bold:10.0" \
      label.color=$SPACE_LABEL_COLOR \
      background.color=$SPACE_BACKGROUND_COLOR \
      background.corner_radius=12 \
      background.height=24 \
      background.drawing=on \
      background.border_color=$SPACE_BORDER_COLOR \
      background.border_width=0 \
      script="$PLUGIN_DIR/aerospace.sh $sid" \
      click_script="aerospace workspace $sid"
  done
else
  # Multi-monitor: Create workspace items per monitor
  # This ensures each monitor's bar only shows its own workspaces
  for monitor in $(aerospace list-monitors | awk '{print $1}'); do
    for sid in $(aerospace list-workspaces --monitor "$monitor"); do
      sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change aerospace_focus_change front_app_switched \
        --set space.$sid \
        display="$monitor" \
        padding_left=2 \
        padding_right=2 \
        icon="$sid" \
        icon.padding_left=6 \
        icon.padding_right=4 \
        icon.color=$SPACE_ICON_COLOR \
        label.padding_left=2 \
        label.padding_right=6 \
        label.font="Hack Nerd Font:Bold:10.0" \
        label.color=$SPACE_LABEL_COLOR \
        background.color=$SPACE_BACKGROUND_COLOR \
        background.corner_radius=12 \
        background.height=24 \
        background.drawing=on \
        background.border_color=$SPACE_BORDER_COLOR \
        background.border_width=0 \
        script="$PLUGIN_DIR/aerospace.sh $sid $monitor" \
        click_script="aerospace workspace $sid"
    done
  done
fi

##### Appearance Change Detection #####
# Reload the bar when macOS switches between light and dark mode
sketchybar --add item appearance_check left \
           --set appearance_check drawing=off update_freq=10 \
           script="$PLUGIN_DIR/appearance_change.sh"

##### Monitor Change Detection #####
# Automatically reload SketchyBar when monitors are connected/disconnected
sketchybar --add item display_change_detector left \
           --set display_change_detector drawing=off \
           script="$PLUGIN_DIR/display_change.sh" \
           --subscribe display_change_detector display_change

##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Some items refresh on a fixed cycle, e.g. the clock runs its script once
# every 10s. Other items respond to events they subscribe to, e.g. the
# volume.sh script is only executed once an actual change in system audio
# volume is registered. More info about the event system can be found here:
# https://felixkratz.github.io/SketchyBar/config/events

# Right side items (ordered right to left visually: clock, status group, system group)
sketchybar --add item clock right \
           --set clock update_freq=10 \
                       icon= icon.padding_left=6 icon.padding_right=2 \
                       label.padding_left=2 label.padding_right=6 \
                       script="$PLUGIN_DIR/clock.sh"

sketchybar --add item spacer_time right \
           --set spacer_time width=5 background.drawing=off icon.drawing=off label.drawing=off \
           --add item wifi right \
           --set wifi update_freq=30 icon.padding_left=4 icon.padding_right=4 \
                      script="$PLUGIN_DIR/wifi.sh" \
                      click_script="open 'x-apple.systempreferences:com.apple.preference.network'" \
           --subscribe wifi wifi_change \
           --add item volume right \
           --set volume update_freq=10 icon.padding_left=4 icon.padding_right=2 \
                        label.padding_left=0 label.padding_right=4 \
                        script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=120 \
                         icon.padding_left=4 icon.padding_right=2 \
                         label.padding_left=0 label.padding_right=4 \
                         script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change \
           --add item spacer_status right \
           --set spacer_status width=5 background.drawing=off icon.drawing=off label.drawing=off

if [ "$SKETCHYBAR_COMPACT_MODE" != "true" ]; then
  # CPU, memory and storage are always visible (alert color above their
  # thresholds). Storage used% matches Finder (purgeable counts as free).
  sketchybar --add item storage right \
             --set storage update_freq=60 icon=󰋊 icon.padding_left=4 icon.padding_right=2 \
                           label.padding_left=0 label.padding_right=4 \
                           script="$PLUGIN_DIR/storage.sh" \
             --add item memory right \
             --set memory update_freq=5 icon=󰍛 icon.padding_left=4 icon.padding_right=2 \
                          label.padding_left=0 label.padding_right=4 \
                          script="$PLUGIN_DIR/memory.sh" \
             --add item cpu right \
             --set cpu update_freq=5 icon=󰻠 icon.padding_left=6 icon.padding_right=2 \
                       label.padding_left=0 label.padding_right=4 \
                       script="$PLUGIN_DIR/cpu.sh"
fi

##### Brackets for visual grouping #####
# Group 1: System (CPU + Memory + Storage) — omitted in SKETCHYBAR_COMPACT_MODE
if [ "$SKETCHYBAR_COMPACT_MODE" != "true" ]; then
  sketchybar --add bracket system_bracket cpu memory storage \
             --set system_bracket background.color=$SPACE_BACKGROUND_COLOR \
                                  background.corner_radius=12 \
                                  background.height=24
fi

# Group 2: Status (Battery + Volume + WiFi)
sketchybar --add bracket status_bracket battery volume wifi \
           --set status_bracket background.color=$SPACE_BACKGROUND_COLOR \
                                background.corner_radius=12 \
                                background.height=24

# Group 3: Time (Clock)
sketchybar --add bracket time_bracket clock \
           --set time_bracket background.color=$SPACE_BACKGROUND_COLOR \
                              background.corner_radius=12 \
                              background.height=24

##### User overrides (add/remove/restyle items) #####
if [ -f "$HOME/.config/makaron/sketchybar.user.sh" ]; then
  # shellcheck disable=SC1090
  ( source "$HOME/.config/makaron/sketchybar.user.sh" ) || echo "makaron: sketchybar.user.sh failed" >&2
fi

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
