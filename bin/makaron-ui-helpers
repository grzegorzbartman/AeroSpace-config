#!/bin/bash
# Shared helper functions for Makaron UI scripts

MAKARON_PATH="${MAKARON_PATH:-$HOME/.local/share/makaron}"
UI_MODE_FILE="${UI_MODE_FILE:-$HOME/.local/state/makaron/ui-mode}"
MAKARON_CONF_PATH="${MAKARON_CONF_PATH:-$HOME/.config/makaron/makaron.conf}"

# Notch detection cache — Swift cold-start (~1s) is too expensive to repeat.
# Invalidate from display_change.sh on monitor hotplug.
NOTCH_CACHE_FILE="${NOTCH_CACHE_FILE:-/tmp/makaron_$(id -u)_notch_v2}"

# Floating-bar offset from the top edge. Must match y_offset in sketchybarrc.
MAKARON_BAR_Y_OFFSET=4

# Bar height, shared with sketchybarrc via SKETCHYBAR_HEIGHT in makaron.conf.
_get_bar_height() {
    (
        SKETCHYBAR_HEIGHT=40
        [ -f "$MAKARON_CONF_PATH" ] && source "$MAKARON_CONF_PATH"
        if [[ "${SKETCHYBAR_HEIGHT:-}" =~ ^[0-9]+$ ]] &&
            [ "$SKETCHYBAR_HEIGHT" -ge 20 ] && [ "$SKETCHYBAR_HEIGHT" -le 80 ]; then
            echo "$SKETCHYBAR_HEIGHT"
        else
            echo 40
        fi
    )
}

# Gap fields written to ~/.aerospace.toml by _set_aerospace_gaps.
MAKARON_GAP_KEYS=(inner.horizontal inner.vertical outer.left outer.bottom outer.right)

set_makaron_conf_value() {
    local key="$1" value="$2"
    mkdir -p "$(dirname "$MAKARON_CONF_PATH")"
    touch "$MAKARON_CONF_PATH"

    if grep -q "^${key}=" "$MAKARON_CONF_PATH" 2>/dev/null; then
        sed -i '' "s|^${key}=.*|${key}=${value}|" "$MAKARON_CONF_PATH"
    else
        printf '%s=%s\n' "$key" "$value" >> "$MAKARON_CONF_PATH"
    fi
}

_get_gap_size() {
    (
        AEROSPACE_GAP_SIZE=12
        [ -f "$MAKARON_CONF_PATH" ] && source "$MAKARON_CONF_PATH"
        if [[ "${AEROSPACE_GAP_SIZE:-}" =~ ^[0-9]+$ ]] &&
            [ "$AEROSPACE_GAP_SIZE" -le 40 ]; then
            echo "$AEROSPACE_GAP_SIZE"
        else
            echo 12
        fi
    )
}

# --- UI Mode State ---
save_ui_mode() {
    local mode="$1"
    mkdir -p "$(dirname "$UI_MODE_FILE")"
    echo "$mode" > "$UI_MODE_FILE"
}

get_ui_mode() {
    if [ -f "$UI_MODE_FILE" ]; then
        cat "$UI_MODE_FILE"
    else
        echo "full"  # default
    fi
}

reload_current_ui() {
    local mode=$(get_ui_mode)
    case "$mode" in
        full)
            echo "Reloading full UI..."
            start_sketchybar
            apply_desktop_state
            ;;
        stop)
            echo "UI is stopped, skipping reload."
            ;;
    esac
}

# --- AeroSpace Config ---

# Detect the built-in notch and the height of its unusable top strip.
# Cache format: "<has_notch> <top_inset>". Cached because Swift cold-start
# (~1s) makes this expensive to repeat; invalidated on monitor hotplug.
_notch_probe() {
    if [ ! -f "$NOTCH_CACHE_FILE" ]; then
        local result="" fmt='^[01] [0-9]+$'
        if [ -x "$MAKARON_PATH/bin/makaron-has-notch" ]; then
            result=$("$MAKARON_PATH/bin/makaron-has-notch" 2>/dev/null)
        fi
        # No binary, or a stale one with the old output format: slow interpreter fallback
        if ! [[ "$result" =~ $fmt ]]; then
            result=$(swift -e 'import AppKit
if let s = NSScreen.screens.first(where: { $0.safeAreaInsets.top > 0 }) {
    print("1 \(max(Int((s.frame.maxY - s.visibleFrame.maxY).rounded()), 0))")
} else { print("0 0") }' 2>/dev/null)
        fi
        if [[ "$result" =~ $fmt ]]; then
            echo "$result" > "$NOTCH_CACHE_FILE" 2>/dev/null || true
        else
            # Probe failed: assume no notch but never cache it, so the next call retries
            result="0 0"
        fi
        echo "$result"
        return
    fi
    cat "$NOTCH_CACHE_FILE" 2>/dev/null || echo "0 0"
}

_has_builtin_notch() {
    [[ "$(_notch_probe | awk '{print $1}')" == "1" ]]
}

_notch_top_inset() {
    local inset
    inset=$(_notch_probe | awk '{print $2}')
    [[ "$inset" =~ ^[0-9]+$ ]] && echo "$inset" || echo 0
}

# Invalidate notch cache (call from display_change handler).
invalidate_notch_cache() {
    rm -f "$NOTCH_CACHE_FILE" 2>/dev/null || true
}

_resolve_aerospace_config_path() {
    local config_link="${AEROSPACE_CONFIG_PATH:-$HOME/.aerospace.toml}"
    if [ -L "$config_link" ]; then
        local target="$(readlink "$config_link")"
        [[ "$target" != /* ]] && target="$(dirname "$config_link")/$target"
        echo "$target"
    else
        echo "$config_link"
    fi
}

# Compute the canonical `outer.top = ...` line for the given mode/gap/notch state.
# Single source of truth for switch_aerospace_config.
#
# full mode: reserve SketchyBar + gap without a notch. A notched built-in screen
# uses only the gap because the notch/menu-bar area absorbs the bar.
_expected_outer_top_line() {
    local mode="$1" gap="$2" has_notch="$3"
    case "$mode" in
        full)
            local bar_top=$(( $(_get_bar_height) + MAKARON_BAR_Y_OFFSET + gap ))
            if [ "$has_notch" = "true" ]; then
                # The bar may extend below the notch strip; keep a full gap
                # between the bar's bottom edge and the window tops.
                local inset overhang
                inset=$(_notch_top_inset)
                overhang=$(( $(_get_bar_height) + MAKARON_BAR_Y_OFFSET - inset ))
                [ "$overhang" -lt 0 ] && overhang=0
                echo "    outer.top = [{ monitor.\"Built-in\" = $((gap + overhang)) }, $bar_top]"
            else
                echo "    outer.top = $bar_top"
            fi
            ;;
    esac
}

switch_aerospace_config() {
    local mode="$1" gap="${2:-$(_get_gap_size)}"

    local config_file
    config_file="$(_resolve_aerospace_config_path)"

    if [ ! -f "$config_file" ]; then
        echo "  ⚠️  AeroSpace config not found: $config_file"
        return 1
    fi

    local has_notch=false
    _has_builtin_notch && has_notch=true

    local outer_top
    outer_top="$(_expected_outer_top_line "$mode" "$gap" "$has_notch")"

    if [ -z "$outer_top" ]; then
        echo "  ⚠️  Unknown aerospace config mode: $mode"
        return 1
    fi

    sed -i '' "s|    outer\.top = .*|$outer_top|" "$config_file"
    echo "  ✓ AeroSpace outer.top set for: $mode mode (notch: $has_notch)"
}

# Build the canonical TOML line for a given gap key (matches what we write).
# Padding mirrors the original template so re-reads are exact-match friendly.
_aerospace_gap_line() {
    local key="$1" size="$2"
    case "$key" in
        inner.horizontal) printf '    inner.horizontal = %s' "$size" ;;
        inner.vertical)   printf '    inner.vertical =   %s' "$size" ;;
        outer.left)       printf '    outer.left =       %s' "$size" ;;
        outer.bottom)     printf '    outer.bottom =     %s' "$size" ;;
        outer.right)      printf '    outer.right =      %s' "$size" ;;
    esac
}

# Set AeroSpace inner/outer gaps (excluding outer.top which depends on SketchyBar/notch).
# Iterates MAKARON_GAP_KEYS so writer and verifier never drift.
# Warns if any expected line is missing — usually a hand-edited config.
_set_aerospace_gaps() {
    local size="$1"  # gap size in px

    local config_file
    config_file="$(_resolve_aerospace_config_path)"
    [ ! -f "$config_file" ] && return 1

    local missing=() key escaped replacement
    for key in "${MAKARON_GAP_KEYS[@]}"; do
        escaped="${key//./\\.}"
        if grep -qE "^    ${escaped} =" "$config_file"; then
            replacement="$(_aerospace_gap_line "$key" "$size")"
            sed -i '' "s|^    ${escaped} =.*|${replacement}|" "$config_file"
        else
            missing+=("$key")
        fi
    done

    echo "  ✓ AeroSpace gaps set to ${size}px"
    if [ ${#missing[@]} -gt 0 ]; then
        echo "  ⚠️  Could not set: ${missing[*]} (hand-edited config?)"
    fi
}

# ============================================================================
# apply_desktop_state — single source of truth for layout (gaps + top).
#
# Scope: layout only. Does NOT start/stop AeroSpace, SketchyBar, or apply macOS
# settings. Callers (makaron-ui-full) handle bootstrap.
#
# Inputs read: ui-mode state file.
# Outputs:     ~/.aerospace.toml (inner/outer gaps + outer.top).
# ============================================================================
apply_desktop_state() {
    local ui_mode gap
    ui_mode=$(get_ui_mode)

    if [ "$ui_mode" = "stop" ]; then
        # In stop mode the user explicitly wants nothing running. Don't touch
        # the toml.
        [ -n "${MAKARON_APPLY_VERBOSE:-}" ] && \
            echo "  UI mode is 'stop' — desktop state not applied"
        return 0
    fi

    gap="$(_get_gap_size)"
    _set_aerospace_gaps "$gap"
    switch_aerospace_config "$ui_mode" "$gap"

    if command -v aerospace &> /dev/null && pgrep -f "AeroSpace" > /dev/null; then
        aerospace reload-config 2>/dev/null || true
    fi
}

# --- AeroSpace ---
start_aerospace() {
    if command -v aerospace &> /dev/null; then
        if ! pgrep -f "AeroSpace" > /dev/null; then
            echo "  Starting AeroSpace..."
            open -a AeroSpace
            sleep 2
        fi
        echo "  Enabling AeroSpace..."
        aerospace enable on
        aerospace reload-config
        echo "  ✓ AeroSpace enabled and config reloaded"
    else
        echo "  ⚠️  AeroSpace not installed"
    fi
}

stop_aerospace() {
    if command -v aerospace &> /dev/null; then
        if pgrep -f "AeroSpace" > /dev/null; then
            echo "  Disabling AeroSpace..."
            aerospace enable off
            echo "  ✓ AeroSpace disabled"
        else
            echo "  ⚠️  AeroSpace not running"
        fi
    else
        echo "  ⚠️  AeroSpace not installed"
    fi
}

# --- SketchyBar ---
sketchybar_service_started() {
    brew services list 2>/dev/null | awk '$1 == "sketchybar" && $2 == "started" { found=1 } END { exit !found }'
}

start_sketchybar() {
    if command -v sketchybar &> /dev/null; then
        if ! sketchybar_service_started; then
            echo "  Starting SketchyBar..."
            if ! brew services start sketchybar; then
                echo "  ⚠️  Failed to start SketchyBar service"
                return 1
            fi
            sleep 2
        fi

        if ! sketchybar_service_started; then
            echo "  ⚠️  SketchyBar service is not running"
            return 1
        fi

        echo "  Reloading SketchyBar config..."
        if ! sketchybar --reload; then
            echo "  ⚠️  Failed to reload SketchyBar config"
            return 1
        fi
        echo "  ✓ SketchyBar started and config reloaded"
    else
        echo "  ⚠️  SketchyBar not installed"
        return 1
    fi
}

stop_sketchybar() {
    if command -v sketchybar &> /dev/null; then
        if sketchybar_service_started; then
            echo "  Stopping SketchyBar..."
            brew services stop sketchybar 2>/dev/null
            echo "  ✓ SketchyBar stopped"
        else
            echo "  ⚠️  SketchyBar not running"
        fi
    else
        echo "  ⚠️  SketchyBar not installed"
    fi
}

verify_desktop_state() {
    local ui_mode gap config_file drift=0 key escaped actual
    ui_mode="$(get_ui_mode)"

    if [ "$ui_mode" = "stop" ]; then
        echo "  ✓ Desktop UI is stopped"
        return 0
    fi

    gap="$(_get_gap_size)"
    config_file="$(_resolve_aerospace_config_path)"
    if [ ! -f "$config_file" ]; then
        echo "  ❌ AeroSpace config not found: $config_file"
        return 1
    fi

    for key in "${MAKARON_GAP_KEYS[@]}"; do
        escaped="${key//./\\.}"
        actual="$(grep -E "^    ${escaped} =" "$config_file" | awk '{print $3}')"
        if [ "$actual" != "$gap" ]; then
            echo "  ⚠️  ${key}=${actual:-missing}, expected $gap"
            drift=1
        fi
    done

    local has_notch=false expected_top actual_top
    _has_builtin_notch && has_notch=true
    expected_top="$(_expected_outer_top_line "$ui_mode" "$gap" "$has_notch")"
    actual_top="$(grep -E '^    outer\.top = ' "$config_file" | head -1)"
    if [ "$actual_top" != "$expected_top" ]; then
        echo "  ⚠️  outer.top does not match gap=$gap, notch=$has_notch"
        drift=1
    fi

    if [ "$drift" -eq 0 ]; then
        echo "  ✓ Desktop state is in sync (gap=${gap}px)"
    fi
    return "$drift"
}

# --- macOS Settings ---

# Toggle menu bar autohide via AppleScript UI click (toggle trick).
# macOS ignores defaults write / CFPreferences — must click the dropdown in System Settings.
# UI strings are localized, so every option carries its EN/PL/DE/FR variants
# (extracted from ControlCenterSettings.appex Localizable.loctable).
_set_menubar_autohide() {
    local target="$1"  # "Always", "In Full Screen Only", or "Never"

    local always='"Always", "Zawsze", "Immer", "Toujours"'
    local desktop_only='"On Desktop Only", "Tylko na Biurku", "Nur auf Schreibtisch", "Sur le bureau uniquement"'
    local fullscreen_only='"In Full Screen Only", "Tylko na pełnym ekranie", "Nur im Vollbildmodus", "En plein écran uniquement"'
    local never='"Never", "Nigdy", "Nie", "Jamais"'

    local target_values opposite_values
    case "$target" in
        "Always")
            target_values="$always"
            opposite_values="$never"
            ;;
        "In Full Screen Only")
            target_values="$fullscreen_only"
            opposite_values="$never"
            ;;
        "Never")
            target_values="$never"
            opposite_values="$always"
            ;;
        *)
            echo "  ⚠️  Unsupported menu bar autohide target: $target"
            return 1
            ;;
    esac

    if ! osascript <<EOF
set targetValues to {$target_values}
set oppositeValues to {$opposite_values}
set validValues to {$always, $desktop_only, $fullscreen_only, $never}

on waitForWindow(proc)
    repeat 20 times
        if exists window 1 of proc then return
        delay 0.3
    end repeat
    error "Timed out waiting for System Settings window"
end waitForWindow

on findMenuBarPopup(proc, validValues)
    tell application "System Events"
        tell proc
            repeat 20 times
                set allElements to entire contents of window 1
                repeat with currentElement in allElements
                    try
                        if role of currentElement is "AXPopUpButton" then
                            set currentValue to value of currentElement as text
                            if validValues contains currentValue then return currentElement
                        end if
                    end try
                end repeat
                delay 0.3
            end repeat
        end tell
    end tell
    error "Could not find menu bar autohide popup"
end findMenuBarPopup

on clickMenuItem(menuPopup, menuValues)
    tell application "System Events"
        click menuPopup
        delay 0.8
        repeat with i from 1 to count of menuValues
            set menuValue to item i of menuValues as text
            if exists menu item menuValue of menu 1 of menuPopup then
                click menu item menuValue of menu 1 of menuPopup
                return
            end if
        end repeat
        key code 53 -- Escape: close the open menu before failing
    end tell
    error "Menu item not found in any supported language"
end clickMenuItem

tell application "System Settings" to quit
delay 1
open location "x-apple.systempreferences:com.apple.ControlCenter-Settings.extension?MenuBar"
delay 2
tell application "System Settings" to activate
delay 1

tell application "System Events"
    tell process "System Settings"
        set frontmost to true
        my waitForWindow(it)
        set menuPopup to my findMenuBarPopup(it, validValues)
        my clickMenuItem(menuPopup, oppositeValues)
        delay 1.5
        set menuPopup to my findMenuBarPopup(it, validValues)
        my clickMenuItem(menuPopup, targetValues)
        delay 1
    end tell
end tell

tell application "System Settings" to quit
EOF
    then
        echo "  ⚠️  Failed to set menu bar autohide to $target"
        echo "     Enable it manually in System Settings > Control Center > Menu Bar"
        return 1
    fi
}

apply_macos_full_settings() {
    echo "  Hiding macOS Dock..."
    defaults write com.apple.dock autohide -bool true
    echo "  ✓ Dock hidden (autohide enabled)"

    echo "  Enabling window grouping by application..."
    defaults write com.apple.dock expose-group-apps -bool true
    killall Dock
    echo "  ✓ Window grouping enabled (required for AeroSpace)"

    echo "  Disabling Three Finger Drag (enabling Mission Control gesture)..."
    defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerDrag -bool false 2>/dev/null
    defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerDrag -bool false 2>/dev/null
    echo "  ✓ Three Finger Swipe Up for Mission Control enabled"

    echo "  Hiding menu bar (auto-hide always)..."
    if _set_menubar_autohide "Always"; then
        echo "  ✓ Menu bar set to auto-hide (Always)"
    else
        echo "  ⚠️  Menu bar autohide was not applied"
    fi
}

restore_macos_defaults() {
    echo "  Showing macOS Dock..."
    defaults write com.apple.dock autohide -bool false
    echo "  ✓ Dock visible"

    echo "  Restoring default window grouping..."
    defaults write com.apple.dock expose-group-apps -bool false
    killall Dock
    echo "  ✓ Window grouping restored to default"

    echo "  Enabling Three Finger Drag..."
    defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerDrag -bool true 2>/dev/null
    defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerDrag -bool true 2>/dev/null
    echo "  ✓ Three Finger Drag enabled"

    echo "  Showing menu bar on desktop (auto-hide in fullscreen)..."
    if _set_menubar_autohide "In Full Screen Only"; then
        echo "  ✓ Menu bar visible on desktop (In Full Screen Only)"
    else
        echo "  ⚠️  Menu bar visibility was not applied"
    fi
}
